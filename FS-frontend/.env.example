# ==============================================================================
# FS-frontend Environment Configuration Template
# ==============================================================================

# Streamlit Port
FRONTEND_PORT=8501

# Backend Connection Endpoints
FASTAPI_BACKEND_URL=http://localhost:8000
REQUEST_TIMEOUT=120.0
# Show answers as they are written (true) or wait for the complete answer (false)
STREAM_RESPONSES=true
# Longest single message sent as chat history (must not exceed the backend's limit)
HISTORY_MESSAGE_MAX_CHARS=4000
# Keep the login after the browser is closed and reopened (true), or only across refreshes and tabs (false)
SESSION_COOKIE_PERSISTENT=false
