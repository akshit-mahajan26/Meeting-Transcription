# ==============================================================================
# FS-AI-Engine Environment Configuration Template
# ==============================================================================

# Server Network Settings
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8001
AI_ENGINE_ENV=development

# ------------------------------------------------------------------------------
# Universal LLM & Embeddings Provider (Google Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL_NAME=gemini-2.5-flash

# Vector Embeddings
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# ------------------------------------------------------------------------------
# Storage & Database Persistence
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meeting_intelligence


# Chunking & segmentation (tune here, no code change needed)
# Similarity below this between neighbouring turns starts a new topic segment (default 0.55)
BOUNDARY_SIMILARITY_THRESHOLD=0.55
# Split one speaker's turn once it passes this many words; 0 = never split (default 0)
MAX_TURN_TOKENS=0
# Sentences repeated at the start of the next turn after such a split (default 0)
CHUNK_OVERLAP_SENTENCES=0

# Max similar turns fetched per search (0 = no cap)
RETRIEVAL_CANDIDATE_LIMIT=1000

# Shared secret between FS-backend and FS-AI-Engine (must match FS-backend/.env)
ENGINE_API_KEY=change-me-to-a-long-random-string
