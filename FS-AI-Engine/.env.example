# ==============================================================================
# FS-AI-Engine Environment Configuration Template
# ==============================================================================

# Server Network Settings
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8001
AI_ENGINE_ENV=development

# ------------------------------------------------------------------------------
# Universal LLM & Embeddings Provider (OpenRouter)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=openai/gpt-4o-mini
LLM_MODEL=openai/gpt-4o-mini

# Site identity sent in OpenRouter ranking headers
OPENROUTER_REFERER=http://localhost:8000
OPENROUTER_TITLE=Meeting-Transcription-Intelligence-Platform

# Vector Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Boundary Detection & Chunking Constraints
BOUNDARY_SIMILARITY_THRESHOLD=0.75
MAX_TURN_TOKENS=400
CHUNK_OVERLAP_SENTENCES=2

# ------------------------------------------------------------------------------
# Storage & Database Persistence
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meeting_intelligence


# Shared secret between FS-backend and FS-AI-Engine (must match FS-backend/.env)
ENGINE_API_KEY=change-me-to-a-long-random-string
