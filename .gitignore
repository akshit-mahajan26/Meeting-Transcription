# Tests, Test Suites, Coverage & Linters
# ==============================================================================
tests/
*/tests/
test_*.py
*_test.py
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
