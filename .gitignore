.ruff_cache/

# ==============================================================================
# Distribution / Packaging
# ==============================================================================
build/
dist/
*.egg-info/
.eggs/
*.egg

# ==============================================================================
# Environment & Secrets (NEVER commit secrets or API keys)
# ==============================================================================
.env
.env.*
*.env
*/*.env
!*.env.example
!.env.example
!*/.env.example

# Streamlit secrets (keep config.toml, ignore secrets.toml)
.streamlit/secrets.toml
*/.streamlit/secrets.toml

