# ==============================================================================
# FS-backend Environment Configuration Template
# ==============================================================================

# Server Network Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_ENV=development
BACKEND_CORS_ORIGINS=["*"]

# Primary & AI-Engine Endpoints
FASTAPI_BACKEND_URL=http://localhost:8000
AI_ENGINE_URL=http://localhost:8001

# Database Configuration
DATABASE_URL=sqlite:///./meeting_platform.db

LLM_MODEL_NAME=gemini-2.5-flash

# Fireflies API Configuration
FIREFLIES_API_KEY=your_fireflies_api_key_here
FIREFLIES_API_URL=https://api.fireflies.ai/graphql

# Authentication (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Shared secret between FS-backend and FS-AI-Engine (must match in both .env files)
ENGINE_API_KEY=change-me-to-a-long-random-string
