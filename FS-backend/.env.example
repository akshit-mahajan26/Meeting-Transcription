# ==============================================================================
# FS-backend Environment Configuration Template
# ==============================================================================

# Server Network Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_ENV=development
# Browser origins allowed to call this API; empty (default) sends no CORS headers. The frontend calls it server-side.
# CORS_ORIGINS=https://your-frontend.example.com

# Primary & AI-Engine Endpoints
FASTAPI_BACKEND_URL=http://localhost:8000
AI_ENGINE_URL=http://localhost:8001

# Database Configuration
# PostgreSQL with the pgvector extension is required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_intelligence

LLM_MODEL_NAME=gemini-2.5-flash

# Fireflies API Configuration
FIREFLIES_API_KEY=your_fireflies_api_key_here
FIREFLIES_API_URL=https://api.fireflies.ai/graphql

# Authentication (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Shared secret between FS-backend and FS-AI-Engine (must match in both .env files)
ENGINE_API_KEY=change-me-to-a-long-random-string

# Set false to disable new account registration
ALLOW_SIGNUP=true

# Raw Fireflies transcript JSON files: off by default; when on, saved as <dir>/<user_id>/<meeting_id>.json
SAVE_RAW_TRANSCRIPTS=false
RAW_TRANSCRIPTS_DIR=transcripts

# Request limits (must match FS-AI-Engine)
QUERY_MAX_CHARS=2000
HISTORY_MAX_MESSAGES=10
HISTORY_MESSAGE_MAX_CHARS=4000
MAX_REQUEST_BODY_BYTES=1048576

# Database connection pool (sum over all services must stay below the server's max_connections - 10)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Meetings ingested at once by one backend process (in-process runner; queue is the meetings table)
INGEST_MAX_CONCURRENCY=3

# Rate limits ("N/period", several separated by ";"), counted in each backend process's memory
RATE_LIMIT_LOGIN_IP=20/minute
RATE_LIMIT_LOGIN_FAILURES=5/15 minutes
RATE_LIMIT_SIGNUP_IP=5/hour
RATE_LIMIT_QUERY=20/minute;300/day
RATE_LIMIT_INGEST_LINK=30/hour

# Trust X-Forwarded-For (the browser's IP, sent by the frontend) only from these addresses; read by uvicorn
FORWARDED_ALLOW_IPS=127.0.0.1
